# Frontend environment example — copy to frontend/.env
# Only VITE_-prefixed vars are exposed to the browser bundle. Anything
# without that prefix stays build-time-only and is stripped from the client.

VITE_APP_ENV=development
# WHY: base URL of the backend API. Read once in src/lib/api.ts.
# Local dev default matches backend HOST/PORT + CORS_ORIGIN.
VITE_API_URL=http://localhost:3000
