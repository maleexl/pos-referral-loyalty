{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",

    "jsx": "react-jsx",
    "useDefineForClassFields": true,

    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": false,
    "noEmit": true,

    // WHY: vite/client supplies import.meta.env typings; node is required
    // because vite.config.ts is included in this config (no separate
    // tsconfig.node.json — a project reference breaks `tsc --noEmit`
    // because composite projects must be allowed to emit).
    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts"]
}
