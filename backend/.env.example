# Backend environment example — copy to backend/.env
# Never commit real backend/.env. Only placeholders here.

# Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://pos_user:change_me_local_only@localhost:5432/pos_referral_loyalty?schema=public

# Auth — simple API keys (see DECISIONS.md #5)
# X-Staff-Key is checked on /staff/* routes.
STAFF_API_KEY=change_me_staff
# X-Admin-Key is checked on /admin/* routes.
ADMIN_API_KEY=change_me_admin

# CORS
CORS_ORIGIN=http://localhost:5173
